# For the WEBSITE (not the server). Teammates: copy this file to ".env.local" and set the address below.
# Nothing secret goes here. Never put a database password in a variable that starts with VITE_.
#
# The address of the MediTrac API your group shares, with no trailing slash.
# Leave this line out (or empty) if you run the API on your own computer: the site then uses http://localhost:5000.
VITE_API_URL=https://your-meditrac-api.onrender.com
