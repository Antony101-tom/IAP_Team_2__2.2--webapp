# For the WEBSITE (not the server). Copy this file to ".env.local" (git ignores it) and fill it in.
# Everything here is compiled into the website and visible to anyone who opens it in a browser,
# so NOTHING SECRET goes in a VITE_ variable: no database password, no JWT_SECRET, no partner's key.

# The address of the MediTrac API your group shares, with no trailing slash.
# Leave this line out (or empty) if you run the API on your own computer: the site then uses http://localhost:5000.
VITE_API_URL=https://your-app.onrender.com

# The website's OWN API key: one of the keys in the server's API_KEYS list, used only for the website
# (don't reuse a partner's key). It identifies "our website" and can be revoked on its own.
VITE_API_KEY=replace-with-the-website-key
