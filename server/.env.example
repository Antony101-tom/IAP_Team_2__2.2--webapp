# Copy this file to .env and fill in your values. .env is ignored by git: NEVER commit or upload it.
# This file (.env.example) is safe to commit: it holds placeholders only.

PORT=5000

# Your database connection string.
#  - Supabase: Project Settings > Database > Connection string, choose "Session pooler",
#    and replace [YOUR-PASSWORD] with your database password (HOSTING.md has the steps).
#  - A PostgreSQL on this computer: postgresql://user:password@localhost:5432/meditrac
DATABASE_URL=postgresql://postgres.your-project:[YOUR-PASSWORD]@your-host.pooler.supabase.com:5432/postgres

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------------------------
# API KEYS (Week 9). EVERY endpoint needs one, sent in the X-API-Key header. The server refuses to
# start if this is empty, and answers 401 to any request without a valid key.
#
# Give each consumer its OWN key (comma-separated, no spaces needed), so you can tell callers apart
# and revoke one without breaking the rest:  your team, each ring partner, your own website.
# Generate each key with:   npm run generate:key
# Send each partner their key privately (direct message), never in the repo or the class channel.
# ---------------------------------------------------------------------------------------------
API_KEYS=replace-with-team-key,replace-with-partner-key,replace-with-website-key

# Requests allowed per API key per minute. Over the limit: 429 with a Retry-After header. Default 100.
RATE_LIMIT_PER_MINUTE=100

# Frontend addresses allowed to log in and change data from a browser (comma-separated). Vite's default is 5173.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Other apps' websites allowed to call the partner endpoints from a browser (comma-separated). "*" = any website.
# CORS only controls browsers; it is NOT authentication. Every request still needs an API key.
PARTNER_ORIGINS=*

# Successful sign-ups allowed per IP per hour (stops fake pharmacies flooding the map)
REGISTER_LIMIT_PER_HOUR=20

# The API contract (openapi.yaml) takes NO login token for adding, changing or deleting medications, so by
# default those calls work with just an API key. Set this to true to REQUIRE a pharmacy login token (do this
# on the live server: otherwise any key holder can edit anyone's stock).
REQUIRE_LOGIN_FOR_WRITES=false

# Database encryption: automatic (on for Supabase, off for localhost). Set true/false to force it.
# DB_SSL=true

# How many proxies (ngrok, Render, Railway...) sit between visitors and this server. 1 is right for those services.
# Use 0 only if the server is exposed directly, with no proxy.
TRUST_PROXY=1

# The partner team's API (Find My Artisan). Put the REAL key only in .env, never in this file.
PARTNER_URL=https://partner-api.example.com
PARTNER_API_KEY=replace-with-the-key-the-partner-gave-you
# Your own hosted MediTrac API (Render address, WITHOUT /api at the end), and one of YOUR keys from API_KEYS.
# Both are used by `npm run sync:artisans`.
MEDITRAC_API_URL=https://your-app.onrender.com
MEDITRAC_API_KEY=replace-with-one-of-your-api-keys
