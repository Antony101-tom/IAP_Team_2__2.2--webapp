# Copy this file to .env and fill in your values. Never share or upload .env.

PORT=5000

# Your database connection string.
#  - Supabase: Project Settings > Database > Connection string, choose "Session pooler",
#    and replace [YOUR-PASSWORD] with your database password (HOSTING.md has the steps).
#  - A PostgreSQL on this computer: postgresql://user:password@localhost:5432/meditrac
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me

# Frontend addresses allowed to log in and change data (comma-separated). Vite's default is 5173.
# The public read-only endpoints (see PUBLIC_API.md) are open to every website regardless.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Other apps' websites allowed to create a pharmacy, log in and manage their own stock from a
# browser (comma-separated). "*" = any website. Server-to-server apps are never affected by this.
PARTNER_ORIGINS=*

# Successful sign-ups allowed per IP per hour (stops fake pharmacies flooding the map)
REGISTER_LIMIT_PER_HOUR=20

# The API contract (openapi.yaml) takes NO login token for adding, changing or deleting
# medications, so by default those calls work without one. If a pharmacy does send its token,
# it can only touch its own stock. Set this to true to REQUIRE a token (do this before the server
# is reachable by people you don't trust: otherwise anyone can edit anyone's stock).
REQUIRE_LOGIN_FOR_WRITES=false

# Database encryption: automatic (on for Supabase, off for localhost). Set true/false to force it.
# DB_SSL=false

# How many proxies (ngrok, Render, Railway...) sit between visitors and this server. 1 is right for those services,
# and makes the rate limits count each visitor separately. Use 0 only if the server is exposed directly, with no proxy.
TRUST_PROXY=1
